#!/usr/bin/env bash
set -euo pipefail

repo=$(cd "$(dirname "$0")/../.." && pwd -P)
temporary=$(mktemp -d "${TMPDIR:-/tmp}/quota-run-test.XXXXXX")
trap 'rm -rf -- "$temporary"' EXIT
mkdir -p "$temporary/bin"
real_date=$(command -v date)
real_sleep=$(command -v sleep)
export real_date real_sleep

cat >"$temporary/bin/opencode" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
count=$(cat "$CASE_ROOT/runs" 2>/dev/null || echo 0)
if [[ $1 == run ]]; then
  printf '%s\n' "$@" >"$CASE_ROOT/arguments.$count"
  printf '%s\n' "$((count + 1))" >"$CASE_ROOT/runs"
  if [[ $SCENARIO == interrupt-run ]]; then
    echo $$ >"$CASE_ROOT/child"
    exec "$real_sleep" 30
  fi
  if [[ $SCENARIO == cli-failure ]]; then exit 1; fi
  printf 'Fake model output\n'
  exit 0
fi
[[ $1 == api ]] || exit 1
case "$2 $3" in
  'post /api/session') echo '{"data":{"id":"ses_test"}}' ;;
  'get /api/session/ses_test')
    location=$PWD
    [[ $SCENARIO != wrong-directory ]] || location=/elsewhere
    jq -cn --arg directory "$location" '{data:{location:{directory:$directory}}}' ;;
  'get /api/session/active')
    if [[ $SCENARIO == active ]]; then echo '{"data":{"ses_test":{"type":"running"}}}'
    else echo '{"data":{}}'; fi ;;
  'post /api/session/ses_test/interrupt') touch "$CASE_ROOT/interrupted" ;;
  'get /api/session/ses_test/message?'*)
    if [[ $SCENARIO == attached-done ]]; then
      echo '{"data":[{"id":"old","type":"idle","outcome":"succeeded"}]}'
    elif [[ $count == 0 || $SCENARIO == no-outcome ]]; then echo '{"data":[]}'
    elif [[ $SCENARIO == other-failure ]]; then
      echo '{"data":[{"id":"failed","type":"idle","outcome":"failed","error":{"message":"authentication failed"}}]}'
    elif [[ $SCENARIO == generic-429 ]]; then
      echo '{"data":[{"id":"failed","type":"idle","outcome":"failed","error":{"status":429,"message":"Too many requests"}}]}'
    elif [[ ( $SCENARIO == quota || $SCENARIO == contradiction ) && $count == 1 ]]; then
      echo '{"data":[{"id":"quota","type":"idle","outcome":"failed","error":{"message":"usage_limit_reached"}}]}'
    else jq -cn --arg id "$count" '{data:[{id:$id,type:"idle",outcome:"succeeded"}]}'; fi ;;
  *) printf 'Unexpected fake command: %s\n' "$*" >&2; exit 1 ;;
esac
FAKE

cat >"$temporary/checker" <<'FAKE'
#!/usr/bin/env bash
set -euo pipefail
count=$(cat "$CASE_ROOT/checks" 2>/dev/null || echo 0)
echo "$((count + 1))" >"$CASE_ROOT/checks"
case "$SCENARIO" in
  checker-failure) exit 1 ;;
  invalid-json) echo 'invalid'; exit ;;
  missing-window) echo '{}'; exit ;;
esac
remaining=100
reset=2030-01-01T00:00:00Z
weekly=2030-01-02T00:00:00Z
if [[ $SCENARIO == quota && $count == 1 || $SCENARIO == wait-first && $count == 0 ||
      $SCENARIO == interrupt-wait || $SCENARIO == stale || $SCENARIO == no-timezone ]]; then remaining=0; fi
[[ $SCENARIO != weekly-only || $count != 0 ]] || remaining=0
[[ $SCENARIO != stale ]] || { reset=1970-01-01T00:00:01Z; weekly=$reset; }
[[ $SCENARIO != no-timezone ]] || { reset=2030-01-01T00:00:00; weekly=$reset; }
five=$remaining
[[ $SCENARIO != weekly-only ]] || five=100
jq -cn --argjson five "$five" --argjson remaining "$remaining" --arg reset "$reset" --arg weekly "$weekly" \
  '{five_hour:{remaining_percent:$five,resetsAt:$reset},weekly:{remaining_percent:$remaining,resetsAt:$weekly}}'
FAKE

cat >"$temporary/bin/date" <<'FAKE'
#!/usr/bin/env bash
if [[ $* == +%s ]]; then echo 1000; else exec "$real_date" "$@"; fi
FAKE

cat >"$temporary/bin/sleep" <<'FAKE'
#!/usr/bin/env bash
echo "$1" >>"$CASE_ROOT/sleeps"
if [[ $SCENARIO == interrupt-wait ]]; then
  echo $$ >"$CASE_ROOT/child"
  exec "$real_sleep" 30
fi
FAKE
chmod +x "$temporary/bin/"*
export PATH="$temporary/bin:$PATH"
export SCENARIO CASE_ROOT XDG_STATE_HOME

tests=0
setup() {
  SCENARIO=$1
  CASE_ROOT="$temporary/$SCENARIO"
  XDG_STATE_HOME="$CASE_ROOT/state"
  mkdir -p "$CASE_ROOT"
}
run() { "$repo/quota-run" --checker "$temporary/checker" "$@" >"$CASE_ROOT/output" 2>&1; }
assert_contains() { grep -Fq -- "$2" "$1" || { cat "$CASE_ROOT/output"; echo "Missing: $2" >&2; exit 1; }; }
pass() { tests=$((tests + 1)); printf 'ok %s - %s\n' "$tests" "$1"; }

setup success
run --auto --agent build --model openai/test 'Do all beads.'
[[ $(cat "$CASE_ROOT/runs") == 1 ]]
assert_contains "$CASE_ROOT/arguments.0" 'Do all beads.'
assert_contains "$CASE_ROOT/arguments.0" '--auto'
assert_contains "$CASE_ROOT/arguments.0" 'openai/test'
assert_contains "$CASE_ROOT/output" 'Requested work completed.'
state_file=$(find "$XDG_STATE_HOME" -name '*.json')
[[ $(jq -r .phase "$state_file") == done ]]
[[ $(stat -c %a "$state_file") == 600 ]]
run --session ses_test
[[ $(cat "$CASE_ROOT/runs") == 1 ]]
pass 'prompt scope, options, private state, and completed-session restart'

setup quota
run 'Do 1 bead.'
[[ $(cat "$CASE_ROOT/runs") == 2 ]]
assert_contains "$CASE_ROOT/arguments.1" 'Continue the original requested work'
if grep -Fq 'Do 1 bead.' "$CASE_ROOT/arguments.1"; then exit 1; fi
[[ $(cat "$CASE_ROOT/sleeps") == 1893541430 ]]
pass 'quota waits for BOTH windows, then continues same session'

for scenario in wait-first weekly-only; do
  setup "$scenario"
  run 'scope'
  [[ $(cat "$CASE_ROOT/runs") == 1 && $(cat "$CASE_ROOT/checks") == 2 ]]
  [[ $(cat "$CASE_ROOT/sleeps") == 1893541430 ]]
  pass "$scenario blocks before sending the prompt"
done

for scenario in checker-failure invalid-json missing-window stale no-timezone active \
                other-failure generic-429 no-outcome cli-failure contradiction; do
  setup "$scenario"
  if run 'scope'; then echo "Unexpected success: $scenario" >&2; exit 1; fi
  [[ ! -f $CASE_ROOT/runs || $(cat "$CASE_ROOT/runs") == 1 ]]
  pass "$scenario stops rather than retrying"
done

setup attached-done
run --session ses_test
[[ ! -f $CASE_ROOT/runs ]]
pass 'attaching to completed work does not resubmit it'

setup wrong-directory
if run --session ses_test; then exit 1; fi
pass 'refuses to resume in a different directory'

setup resumed-interrupted
run 'Do 1 bead.'
state_file=$(find "$XDG_STATE_HOME" -name '*.json')
jq '.phase = "running"' "$state_file" >"$CASE_ROOT/updated"
mv "$CASE_ROOT/updated" "$state_file"
echo 0 >"$CASE_ROOT/runs"
run --session ses_test
assert_contains "$CASE_ROOT/arguments.0" 'Continue the original requested work'
pass 'interrupted-session restart continues rather than repeating prompt'

setup contradiction
# The first failure persists the session before the checker contradiction stops it.
if run 'Do 1 bead.'; then exit 1; fi
SCENARIO=quota
echo 1 >"$CASE_ROOT/checks"
run --session ses_test
[[ $(cat "$CASE_ROOT/runs") == 2 ]]
assert_contains "$CASE_ROOT/arguments.1" 'Continue the original requested work'
pass 'restart recovers a persisted quota failure and waits before resuming'

setup invalid-arguments
for args in '--threshold 0' '--threshold nan' '--buffer -1' '--unknown x'; do
  read -r -a options <<<"$args"
  if run "${options[@]}" 'scope'; then exit 1; fi
done
if run --session ../../bad; then exit 1; fi
if run --session ses_test 'scope'; then exit 1; fi
if run; then exit 1; fi
if run --checker "$temporary/missing" 'scope'; then exit 1; fi
run --help
pass 'validates arguments and exposes help'

for scenario in interrupt-run interrupt-wait; do
  setup "$scenario"
  run 'scope' & wrapper=$!
  for ((attempt=0; attempt<200; attempt++)); do
    [[ ! -f $CASE_ROOT/child ]] || break
    "$real_sleep" 0.05
  done
  [[ -f $CASE_ROOT/child ]] || { kill "$wrapper"; echo 'Child did not start' >&2; exit 1; }
  if [[ $scenario == interrupt-wait ]]; then
    if "$repo/quota-run" --checker "$temporary/checker" --session ses_test \
      >"$CASE_ROOT/second-output" 2>&1; then exit 1; fi
    assert_contains "$CASE_ROOT/second-output" 'Another quota-run wrapper owns this session'
  fi
  # run is a shell function: target the actual wrapper, not its waiting test subshell.
  target=$(pgrep -P "$wrapper" | head -n 1)
  kill -TERM "$target"
  if wait "$wrapper"; then exit 1; else [[ $? == 130 ]]; fi
  if kill -0 "$(cat "$CASE_ROOT/child")" 2>/dev/null; then echo 'Child survived stop' >&2; exit 1; fi
  if [[ $scenario == interrupt-run ]]; then [[ -f $CASE_ROOT/interrupted ]]; fi
  pass "$scenario stops child and preserves resumable state"
done

printf 'Passed %s isolated Bash checks; no model calls.\n' "$tests"

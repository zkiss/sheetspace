#!/bin/sh
set -u

script_dir="$(CDPATH= cd "$(dirname "$0")" && pwd -P)" || exit 1
repo_root="$(git -C "$script_dir" rev-parse --show-toplevel)" || exit 1
gradle_root="${GRADLE_USER_HOME:-$HOME/.gradle}"

log="$(mktemp "${TMPDIR:-/tmp}/codex-implement.XXXXXX.jsonl")"
last="$(mktemp "${TMPDIR:-/tmp}/codex-implement.XXXXXX.last")"
error="$(mktemp "${TMPDIR:-/tmp}/codex-implement.XXXXXX.error")"

cleanup() {
  rm -f "$log" "$last" "$error"
}
trap cleanup EXIT INT TERM

set -- exec \
  --model "gpt-5.6-sol" \
  --config model_reasoning_effort=medium \
  --config 'approval_policy="never"' \
  --config 'default_permissions="sheetspace-implement"' \
  --config 'permissions.sheetspace-implement.filesystem={":root"="read",":tmpdir"="write",":slash_tmp"="write",":workspace_roots"={"."="write",".agents"="read",".codex"="read"}}' \
  --config 'permissions.sheetspace-implement.network.enabled=true' \
  --json \
  --output-last-message "$last" \
  --add-dir "$gradle_root" \
  --cd "$repo_root"

if [ -n "${SSH_AUTH_SOCK:-}" ]; then
  set -- "$@" \
    --config "permissions.sheetspace-implement.network.unix_sockets={\"$SSH_AUTH_SOCK\"=\"allow\"}"
fi

set -- "$@" "Do next bead. Subagents allowed. Caveman ultra."

codex "$@" >"$log" 2>"$error" &
codex_pid=$!

session_id=
while [ -z "$session_id" ]; do
  session_id="$(jq -r 'select(.type == "thread.started") | .thread_id' "$log" 2>/dev/null | tail -n 1)"

  if [ -n "$session_id" ] || ! kill -0 "$codex_pid" 2>/dev/null; then
    break
  fi

  sleep 1
done

if [ -n "$session_id" ]; then
  printf 'Session ID: %s\n' "$session_id"
  printf 'To view session: codex resume %s' "$session_id"
fi

wait "$codex_pid"
status=$?

if [ "$status" -ne 0 ]; then
  printf '\n\nCodex failed with status %s:\n' "$status" >&2
  if [ -s "$error" ]; then
    cat "$error" >&2
  else
    printf 'No error details were provided.\n' >&2
  fi
else
  printf '\n\nFinal AI response:\n'
  cat "$last"
  printf '\n'
fi

exit "$status"
